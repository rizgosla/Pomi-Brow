# Copy to .env and fill in. Every value is optional for a local build:
# without a Sanity project the site renders from src/content/seed/*.json.

# Sanity (create at sanity.io/manage). Studio lives at /admin on the deployed site.
PUBLIC_SANITY_PROJECT_ID=
PUBLIC_SANITY_DATASET=production

# Cloudflare Web Analytics token (cookieless, no consent banner needed).
PUBLIC_CF_ANALYTICS_TOKEN=

# Where the contact form's Pages Function forwards submissions (a webhook, Formspree, Resend endpoint, etc).
# Set as a Cloudflare Pages environment variable in production. Never put submissions in Sanity.
FORM_WEBHOOK_URL=
