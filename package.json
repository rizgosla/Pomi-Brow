{
  "name": "pomi-b-brow-studio",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev --port 4400",
    "build": "astro build && node scripts/check-no-placeholders.mjs && node scripts/check-links.mjs",
    "build:nocheck": "astro build",
    "preview": "astro preview --port 4400",
    "check": "astro check",
    "test": "node --test \"tests/**/*.test.ts\"",
    "media:import": "node scripts/import-media.mjs",
    "logo:export": "powershell -ExecutionPolicy Bypass -File scripts/export-logo.ps1",
    "live:embeds": "node scripts/import-live-embeds.mjs",
    "live:capture": "node scripts/capture-live.mjs"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/react": "^6.0.5",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/albert-sans": "^5.3.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource/italiana": "^5.3.0",
    "@sanity/astro": "^3.5.1",
    "@sanity/client": "^8.6.0",
    "@sanity/image-url": "^2.1.1",
    "astro": "^7.3.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-is": "^19.2.8",
    "sanity": "^6.12.0",
    "sharp": "^0.35.4",
    "styled-components": "^6.1.19"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260907.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "entities": "^4.5.0",
    "node-html-parser": "^7.1.0",
    "puppeteer-core": "^25.10.0",
    "typescript": "^5.9.3",
    "wrangler": "^4.131.1"
  }
}
