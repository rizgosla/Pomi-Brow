---
// The first viewport. Left: one serif line, a quiet lede, one action. Right: a wall of the actual work.
//
// The grid replaces the single hero photograph deliberately. One photo answered "is this good?" and
// left "what do they even do here?" unanswered until the price grid, ~4 screens down. Nine healed
// results across all four categories answer both in the first viewport, and answer the range question
// the four-tile Instagram sample was failing at (three of its four tiles read "Microblading").
//
// Ratios are authored, not found: every source image is square (0.90-1.29, all ~1320px), so the mix
// comes from row spans over a 12-row grid with object-fit: cover. Spans are assigned by subject:
// the studio's before/after images are stacked pairs, and a pair only survives in the squarest cell
// (span 5), so those go there and single healed shots take the landscape cells. See index.astro.
import type { SiteSettings, Photo as PhotoType } from "../lib/content";
import Photo from "./Photo.astro";
import Icon from "./Icon.astro";

export interface HeroTile {
  photo: PhotoType;
  /** Desktop column, 1-3. */
  col: 1 | 2 | 3;
  /** Desktop start row on the 12-row grid. */
  row: number;
  /** Rows spanned. 5 ~ square, 4 ~ landscape, 3 ~ wide. */
  span: 3 | 4 | 5;
  /** Crop framing, e.g. "50% 35%". */
  focus?: string;
}

interface Props {
  settings: SiteSettings;
  tiles: HeroTile[];
}
const { settings, tiles } = Astro.props;

// The occasions the line cycles through. The first is the resting state, and the only
// one prefers-reduced-motion users see.
const OCCASIONS = ["meeting", "night out", "workout", "brunch", "errand", "pilates class", "drop off"];

const categories = [
  { label: "Brows", mod: "brow" },
  { label: "Eyes", mod: "eye" },
  { label: "Lips", mod: "lip" },
  { label: "Hair", mod: "hair" },
];
---

{/* No .reveal here: the scroll-entry reveal is for blocks that arrive, and the hero is already there.
    Fading it in would hold the page's LCP element at zero opacity for the length of the transition. */}
<section class="hero page" data-hero>
  <div class="hero__copy">
    <h1>
      Perfect brows for every{" "}
      <span class="hero__cycle" aria-hidden="true" data-cycle>
        {OCCASIONS.map((w, i) => (
          <span class="hero__word" style={`--i:${i}`}>{w}</span>
        ))}
      </span>
      <span class="visually-hidden">occasion.</span>
    </h1>
    <p class="lede">
      Permanent makeup mapped, measured, and drawn by one artist, so the result looks like you on a good day.
    </p>
    <div class="hero__actions">
      <a class="btn hero__call" href={`tel:${settings.phoneTel}`}>
        <Icon name="phone" />
        Call {settings.phone}
      </a>
      <a class="link" href="#work">
        See the work
        <Icon name="arrow" />
      </a>
    </div>
    <p class="hero__meta">
      <span>
        {settings.locationLine}. Every service is two visits: the session, then a perfecting touch-up around six weeks
        later.
      </span>
    </p>
  </div>

  <figure class="hero__work">
    <div class="hero__grid">
      {
        tiles.map((tile, i) => (
          <div
            class="hero__tile"
            style={`--col:${tile.col};--row:${tile.row};--span:${tile.span}${
              tile.focus ? `;--focus:${tile.focus}` : ""
            }`}
          >
            <Photo
              photo={tile.photo}
              loading={i === 0 ? "eager" : "lazy"}
              fetchpriority={i === 0 ? "high" : "auto"}
              widths={[280, 420, 560]}
              sizes="(min-width: 60rem) 17vw, 45vw"
            />
          </div>
        ))
      }
    </div>
    {/* Nothing is drawn over a photograph, so the categories are named beneath the wall
        rather than pinned to the tiles. */}
    <figcaption class="hero__legend">
      <span>Healed results and before-and-afters. All of it Pomi's own work.</span>
      <span class="hero__legend-tags">
        {categories.map((c) => <span class={`tag tag--${c.mod}`}>{c.label}</span>)}
      </span>
    </figcaption>
  </figure>
</section>

<style>
  /* The first load is the hero and nothing else: it is exactly one screen under the
     header, so the next section starts at the fold rather than peeking into it. */
  .hero {
    display: grid;
    gap: var(--space-7);
    align-content: center;
    min-height: calc(100svh - var(--header-h));
    padding-block: var(--space-7);
  }
  .hero__copy {
    display: grid;
    gap: var(--space-5);
    align-content: center;
  }
  .hero__copy h1 {
    max-width: 18ch;
  }
  .hero__copy .lede {
    font-size: clamp(1.25rem, 1.1rem + 0.5vw, 1.5rem);
    max-width: 34ch;
  }
  /* The occasion swap, after the Oasis Dental hero. Every word sits in one grid cell,
     so the span is as wide as its longest word and the line never reflows. Each word
     runs the same loop, offset by its index: it rises in out of a slight blur, holds,
     then lifts out as the next arrives. Seven words at 2.4s each is a 16.8s loop, so
     one word owns 1/7 (14.29%) of it. CSS only: nothing to wait for, nothing to fail.
     Pink is spent here on purpose; DESIGN.md records the exception. */
  .hero__cycle {
    display: inline-grid;
    align-items: start;
    vertical-align: top;
    color: var(--pink-ink);
  }
  .hero__word {
    grid-area: 1 / 1;
    justify-self: start;
    opacity: 0;
    animation: hero-word-swap 16.8s var(--ease-out) infinite;
    animation-delay: calc(var(--i) * 2.4s);
  }
  @keyframes hero-word-swap {
    0% {
      opacity: 0;
      transform: translateY(0.35em);
      filter: blur(4px);
    }
    2.5% {
      opacity: 1;
      transform: none;
      filter: blur(0);
    }
    12% {
      opacity: 1;
      transform: none;
      filter: blur(0);
    }
    14.29% {
      opacity: 0;
      transform: translateY(-0.35em);
      filter: blur(4px);
    }
    100% {
      opacity: 0;
      transform: translateY(0.35em);
      filter: blur(4px);
    }
  }
  /* Reduced motion: the first word simply stays. */
  @media (prefers-reduced-motion: reduce) {
    .hero__word {
      animation: none;
    }
    .hero__word:first-child {
      opacity: 1;
    }
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-5);
    margin-top: var(--space-2);
  }
  .hero__call {
    display: none;
  }
  /* The rule spans the copy column so it lands on the same edge as the heading;
     the sentence keeps its own measure inside it. */
  .hero__meta {
    font-size: var(--fs-small);
    color: var(--ink-muted);
    padding-top: var(--space-4);
    border-top: 1px solid var(--border);
  }
  .hero__meta span {
    display: block;
    max-width: 46ch;
  }
  .hero__work {
    margin: 0;
    display: grid;
    gap: var(--space-4);
    align-content: center;
  }

  /* Phone: one wide anchor tile, then a 2x2. Five tiles, not nine -- at 390px a
     nine-tile wall renders each face at ~170px and proves nothing. */
  .hero__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-3);
  }
  .hero__tile {
    min-width: 0;
  }
  .hero__tile :global(.photo) {
    aspect-ratio: 1 / 1;
  }
  .hero__tile :global(.photo img) {
    object-position: var(--focus, 50% 45%);
  }
  .hero__tile:first-child {
    grid-column: span 2;
  }
  .hero__tile:first-child :global(.photo) {
    aspect-ratio: 3 / 2;
  }
  .hero__tile:nth-child(n + 6) {
    display: none;
  }

  .hero__legend {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3) var(--space-4);
    font-size: var(--fs-caption);
    color: var(--ink-muted);
  }
  .hero__legend-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  @media (min-width: 60rem) {
    .hero {
      /* 36 : 43 inside the 82rem column keeps the wall at the ~43rem it has always
         rendered at 1440, while the larger headline fills its column up to a 3rem gap
         instead of stopping short and leaving white between the words and the work. */
      grid-template-columns: minmax(0, 36fr) minmax(0, 43fr);
      align-items: center;
      column-gap: var(--space-7);
      padding-block: var(--space-6);
    }
    .hero__call {
      display: inline-flex;
    }

    /* Three columns over twelve rows. Each column's spans sum to 12 but in a
       different order (5-4-3 / 3-5-4 / 4-3-5), so no tile edge lines up with its
       neighbour across the wall. That offset is the whole effect. Placement is
       explicit rather than auto-flowed, so the wall is identical every build. */
    .hero__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      grid-template-rows: repeat(12, 1fr);
      /* Fits inside the one-screen hero: the screen, less the header, the hero's own
         padding, and ~4rem for the caption row beneath the wall. */
      height: min(calc(100svh - var(--header-h) - 2 * var(--space-6) - 4rem), 42rem);
      gap: var(--space-3);
    }
    .hero__tile,
    .hero__tile:first-child,
    .hero__tile:nth-child(n + 6) {
      display: block;
      min-height: 0;
      grid-column: var(--col);
      grid-row: var(--row) / span var(--span);
    }
    /* Ratio comes from the cell now, so the frame fills it and the image covers. */
    .hero__tile :global(.photo),
    .hero__tile:first-child :global(.photo) {
      aspect-ratio: auto;
      height: 100%;
    }
  }
</style>
