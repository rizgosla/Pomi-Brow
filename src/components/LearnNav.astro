---
// The Learn section's index, as a list that stays on the left while you read.
//
// This replaced grouping the articles under Brows / Eyes / Lips / Hair. The reader arriving
// here has one question, not a category to shop -- the grouping made them work out which
// bucket their question lived in before they could look for it, and stranded a fifth
// "Start here" pseudo-group for the articles that relate to no single service.
//
import type { LearnArticle } from "../lib/content";
import Icon from "./Icon.astro";

interface Props {
  articles: LearnArticle[];
  /** Slug of the article being read, when this is rendering beside one. */
  current?: string;
  /** Heading text; the index and an article page want different words. */
  heading?: string;
}
const { articles, current, heading = "All articles" } = Astro.props;
---

<nav class="learnnav" aria-label="Learn articles">
  <details class="learnnav__disclosure" open>
    <summary class="learnnav__summary">
      <span>{heading}</span>
      <span class="learnnav__mark" aria-hidden="true">
        <span class="learnnav__count">{articles.length}</span>
        <Icon name="plus" class="learnnav__plus" />
        <Icon name="minus" class="learnnav__minus" />
      </span>
    </summary>
    <ul class="learnnav__list">
      {
        articles.map((a) => {
          const active = a.slug === current;
          return (
            <li>
              <a
                class:list={["learnnav__item", { "is-active": active }]}
                href={`/learn/${a.slug}`}
                aria-current={active ? "page" : undefined}
              >
                <span class="learnnav__label">{a.title}</span>
              </a>
            </li>
          );
        })
      }
    </ul>
  </details>
</nav>

<style>
  .learnnav {
    font-size: var(--fs-small);
  }
  .learnnav__summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    min-height: 44px;
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--border);
    font-weight: 500;
    color: var(--ink);
    cursor: pointer;
    list-style: none;
  }
  .learnnav__summary::-webkit-details-marker {
    display: none;
  }
  .learnnav__mark {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    color: var(--ink-muted);
  }
  .learnnav__count {
    font-variant-numeric: tabular-nums;
  }
  /* Collapsed shows plus, open shows minus - the same affordance the FAQ uses. */
  .learnnav :global(.learnnav__plus),
  .learnnav :global(.learnnav__minus) {
    width: 1rem;
    height: 1rem;
  }
  .learnnav__disclosure[open] :global(.learnnav__plus),
  .learnnav__disclosure:not([open]) :global(.learnnav__minus) {
    display: none;
  }
  .learnnav__list {
    display: grid;
    margin-top: var(--space-2);
  }
  .learnnav__item {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    min-height: 44px;
    padding: var(--space-2) 0;
    text-decoration: none;
    color: var(--ink-muted);
    transition: color var(--dur-fast) ease;
  }
  .learnnav__item:hover {
    color: var(--ink);
  }
  /* The row you are reading: ink and weight, nothing else. */
  .learnnav__item.is-active {
    color: var(--ink);
    font-weight: 500;
  }
  .learnnav__label {
    min-width: 0;
  }

  @media (min-width: 60rem) {
    .learnnav {
      position: sticky;
      top: calc(var(--header-h) + var(--space-6));
      /* Ten rows must never outgrow the viewport and strand the last of them. */
      max-height: calc(100svh - var(--header-h) - var(--space-8));
      overflow-y: auto;
    }
    /* On desktop the list is the column, so the disclosure is always open and its
       toggle is inert. */
    .learnnav__disclosure {
      pointer-events: none;
    }
    /* Links stay live; the toggle does not, so the column cannot be collapsed at a
       width where it is the layout rather than a disclosure. */
    .learnnav__item {
      pointer-events: auto;
    }
    .learnnav__summary {
      cursor: default;
    }
    /* On desktop the list is simply there; nothing to expand and no count to explain. */
    .learnnav__mark {
      display: none;
    }
  }
</style>

<script>
  // Below 60rem the list is collapsed by default so the answer comes first; at and above
  // it the list is the left column and must always be open. Done in script rather than CSS
  // because `open` is an attribute, and re-run on resize so a rotation cannot strand it shut.
  const details = document.querySelector<HTMLDetailsElement>(".learnnav__disclosure");
  if (details) {
    const wide = window.matchMedia("(min-width: 60rem)");
    const sync = () => {
      if (wide.matches) details.open = true;
    };
    sync();
    wide.addEventListener("change", sync);
    // Only collapse on first load at narrow widths; never fight the reader afterwards.
    if (!wide.matches) details.open = false;
  }
</script>
