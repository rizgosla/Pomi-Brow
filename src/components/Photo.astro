---
// Renders a Photo from the content layer. Every photograph gets the same mild warm grade and a faint
// grain so phone shots taken in different light sit together on one page. The grade is deliberately
// light: the pigment color is the proof and must not be misrepresented.
import { Image } from "astro:assets";
import type { Photo } from "../lib/content";

interface Props {
  photo: Photo;
  sizes?: string;
  widths?: number[];
  loading?: "eager" | "lazy";
  fetchpriority?: "high" | "low" | "auto";
  class?: string;
  style?: string;
  /** Rendered aspect ratio, e.g. "4 / 5". Omit to keep the image's own ratio. */
  ratio?: string;
  /** Rounded, hairline-bordered frame. */
  framed?: boolean;
}

const {
  photo,
  sizes = "(min-width: 60rem) 33vw, 100vw",
  widths = [480, 800, 1200],
  loading = "lazy",
  fetchpriority = "auto",
  class: className,
  style,
  ratio,
  framed = true,
} = Astro.props;

const frameStyle = [style, ratio ? `aspect-ratio:${ratio}` : null].filter(Boolean).join(";");
---

<div class:list={["photo", { "photo--framed": framed }, className]} style={frameStyle || undefined}>
  {
    photo.kind === "local" ? (
      <Image
        src={photo.image}
        alt={photo.alt}
        widths={widths}
        sizes={sizes}
        loading={loading}
        fetchpriority={fetchpriority}
        decoding={loading === "eager" ? "sync" : "async"}
        quality={80}
        format="webp"
      />
    ) : (
      <img
        src={photo.src}
        srcset={photo.srcset}
        sizes={sizes}
        width={photo.width}
        height={photo.height}
        alt={photo.alt}
        loading={loading}
        fetchpriority={fetchpriority}
        decoding="async"
      />
    )
  }
</div>

<style>
  .photo {
    position: relative;
    overflow: hidden;
    background: var(--surface);
  }
  .photo--framed {
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }
  .photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.88) contrast(1.02);
  }
  .photo::after {
    /* warm grain, barely there */
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0.04;
    mix-blend-mode: multiply;
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='160' height='160'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='2' stitchTiles='stitch'/><feColorMatrix values='0 0 0 0 0.35 0 0 0 0 0.25 0 0 0 0 0.15 0 0 0 1 0'/></filter><rect width='100%' height='100%' filter='url(%23n)'/></svg>");
    background-size: 160px 160px;
  }
</style>
