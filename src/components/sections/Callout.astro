---
// A note docked to a slide: a note, a line in Pomi's voice, a medical caution, or where to read
// next. Every tone has one anatomy, the GOV.UK summary list's and the print sidehead's: the title
// first with its label beneath it as a subtitle (the hgroup pattern), and the text to the right,
// its first line level with the title's. The label used to sit above the title, which read as the
// title sitting at the bottom and broke the No-Kicker Rule.
//
// Rounded bands: bone for notes, links and medical cautions, pale pink for Pomi's own words, which
// stay in the serif. A caution is no longer a margin note; the red "Medical note" label carries
// the meaning, so the wording is never set apart by a thinner, lesser container. The label is
// aria-hidden and the h3 says the same word first ("Medical note: ..."), so it is heard once.
//
// From 60rem the two columns are a wrapping flex row rather than a fixed grid. Title and text run
// 1 : 2 with a 12rem floor under the title -- exactly minmax(12rem, 1fr) 2fr wherever that fits --
// but a note in a narrow column (a split's 7/12 on a laptop) stacks instead of squeezing its text
// to a few words a line. Baseline alignment, not start, puts the title's first line level with
// the text's whatever the text is: body copy, the taller serif quote, or 44px link rows.
import type { Callout as CalloutType } from "../../lib/sections";
import Icon from "../Icon.astro";

interface Props {
  callout: CalloutType;
  class?: string;
}
const { callout, class: className } = Astro.props;

/** What each tone is called: spoken before the title, and shown as the label under it. */
const TONES: Record<CalloutType["tone"], { name: string; label?: string; tag?: string }> = {
  note: { name: "Note", label: "Note", tag: "tag" },
  voice: { name: "From Pomi", label: "From Pomi", tag: "tag tag--pink" },
  caution: { name: "Medical note", label: "Medical note", tag: "tag tag--red" },
  links: { name: "Read next" },
};
const tone = TONES[callout.tone] ?? TONES.note;
const title = callout.title ?? "";
// A links note titled "Read next" would be announced "Read next: Read next"; say it once.
const spoken = title.trim().toLowerCase().startsWith(tone.name.toLowerCase()) ? "" : `${tone.name}: `;
---

<aside class:list={["callout", `callout--${callout.tone}`, className]} role="note">
  <div class="callout__head">
    <h3 class="callout__title">{spoken && <span class="visually-hidden">{spoken}</span>}{title}</h3>
    {
      tone.label && (
        <span class:list={[tone.tag, "callout__label"]} aria-hidden="true">
          {tone.label}
        </span>
      )
    }
  </div>
  <div class="callout__body">
    {callout.text && <p class="callout__text">{callout.text}</p>}
    {
      callout.bullets && callout.bullets.length > 0 && (
        <ul class="callout__list">
          {callout.bullets.map((b) => (
            <li>{b}</li>
          ))}
        </ul>
      )
    }
    {
      callout.links && callout.links.length > 0 && (
        <ul class="callout__links">
          {callout.links.map((l) => (
            <li>
              <a class="link" href={l.href}>
                {l.label}
                <Icon name="arrow" />
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</aside>

<style>
  /* Phones and tablets: one column, in reading order -- title, label, text. */
  .callout {
    display: grid;
    gap: var(--space-4);
    padding: var(--space-5);
    border-radius: var(--radius);
    background: var(--bone);
  }
  .callout--voice {
    background: var(--pale-pink);
  }
  /* The label hangs under the title as its subtitle, closer to it than to the text. */
  .callout__head {
    display: grid;
    gap: var(--space-2);
    justify-items: start;
    align-content: start;
    min-width: 0;
  }
  /* Size, weight and tracking come from the site's h3. */
  .callout__title {
    max-width: 22ch;
  }
  .callout__body {
    display: grid;
    gap: var(--space-3);
    align-content: start;
    min-width: 0;
  }
  .callout__text {
    max-width: 64ch;
    font-size: var(--fs-body);
    line-height: 1.6;
    color: var(--ink-body);
  }
  /* Pomi's own words are set in the serif, the way a quote is set elsewhere on the site. */
  .callout--voice .callout__text {
    max-width: 44ch;
    font-family: var(--font-display);
    font-variation-settings: "opsz" 24;
    font-size: var(--fs-quote);
    line-height: 1.35;
    letter-spacing: -0.01em;
    color: var(--ink);
  }
  .callout__list {
    display: grid;
    gap: var(--space-2);
    max-width: 64ch;
    padding-left: 1.1rem;
    list-style: disc;
    font-size: var(--fs-body);
    line-height: 1.6;
    color: var(--ink-body);
  }
  .callout__list li::marker {
    color: var(--ink-muted);
  }
  /* Link rows fill the text column two or three across; the 44px link height is the row pitch,
     so no row gap is needed. Each li is a flex box so the link sits on no line box of its own
     and the rows stay exactly 44px. */
  .callout__links {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(13rem, 100%), 1fr));
    gap: 0 var(--space-5);
  }
  .callout__links li {
    display: flex;
    min-width: 0;
  }
  @media (min-width: 60rem) {
    .callout {
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      gap: var(--space-4) var(--space-7);
      padding: var(--space-6);
    }
    .callout__head {
      flex: 1 1 12rem;
    }
    .callout__body {
      flex: 2 1 24rem;
    }
  }
</style>
