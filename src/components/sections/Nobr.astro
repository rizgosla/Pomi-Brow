---
// Text with its hyphenated words kept whole: a balanced heading otherwise breaks "touch-ups" at
// the hyphen ("touch- / ups"). Words of 13 letters or more come back in a .hy span, which the
// page title lets hyphenate on a phone ("micropig- / mentation") instead of overflowing it.
import { titleParts } from "../../lib/text";

interface Props {
  text: string;
}
const { text } = Astro.props;
---

{titleParts(text).map((p) => (p.kind === "keep" ? <span class="nobr">{p.text}</span> : p.kind === "long" ? <span class="hy">{p.text}</span> : p.text))}
