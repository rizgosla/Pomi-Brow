---
// Two or four cards, each one point: a title and a sentence, or a title and a few bullets,
// with a photograph above it when the point has one.
import type { Section } from "../../lib/sections";
import ImageSlot from "./ImageSlot.astro";
import Callout from "./Callout.astro";

type Grid = Extract<Section, { type: "grid" }>;
interface Props {
  section: Grid;
}
const { section } = Astro.props;
const columns = section.columns ?? (section.items.length <= 2 ? 2 : 4);
---

<div class="cards-wrap">
  <ul class:list={["cards", `cards--${columns}`]}>
    {
      section.items.map((item, i) => (
        <li class="card cards__item reveal" style={`--i: ${i}`}>
          {item.image && <ImageSlot image={item.image} class="cards__image" sizes="(min-width: 60rem) 25vw, (min-width: 40rem) 50vw, 100vw" widths={[480, 800]} />}
          <h3 class="cards__title">{item.title}</h3>
          {item.text && <p class="cards__text">{item.text}</p>}
          {
            item.bullets && item.bullets.length > 0 && (
              <ul class="cards__list">
                {item.bullets.map((b) => (
                  <li>{b}</li>
                ))}
              </ul>
            )
          }
        </li>
      ))
    }
  </ul>
  {section.callout && <Callout callout={section.callout} class="cards__callout reveal" />}
</div>

<style>
  .cards-wrap {
    display: grid;
    gap: var(--space-7);
  }
  .cards {
    display: grid;
    gap: var(--space-5);
  }
  .cards__item {
    display: grid;
    gap: var(--space-3);
    align-content: start;
    justify-items: start;
  }
  .cards__item :global(.cards__image) {
    width: 100%;
    margin-bottom: var(--space-3);
  }
  .cards__text {
    color: var(--ink-body);
    max-width: 34ch;
  }
  .cards__list {
    display: grid;
    gap: var(--space-2);
    padding-left: 1.1rem;
    list-style: disc;
    color: var(--ink-body);
    max-width: 34ch;
  }
  .cards__list li::marker {
    color: var(--ink-muted);
  }
  .cards-wrap :global(.cards__callout) {
    max-width: 56rem;
  }
  @media (min-width: 40rem) {
    .cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 60rem) {
    .cards--4 {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
    .cards--2 .cards__text,
    .cards--2 .cards__list {
      max-width: 48ch;
    }
  }
</style>
