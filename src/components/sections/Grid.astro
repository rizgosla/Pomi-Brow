---
// Two, three or four tiles, each one point: a title and a sentence, or a title and a few
// bullets, with a photograph above it when the point has one, and a link when the tile is a
// door to another page. Bullet-card grids run four across so the section stays short; only a
// two-item grid keeps two columns. Tiles are light gray with a pink outline; the section's callout
// spans the full width beneath.
import type { Section } from "../../lib/sections";
import ImageSlot from "./ImageSlot.astro";
import Callout from "./Callout.astro";
import Icon from "../Icon.astro";

type Grid = Extract<Section, { type: "grid" }>;
interface Props {
  section: Grid;
}
const { section } = Astro.props;
const columns = section.items.length <= 2 ? 2 : section.columns === 3 ? 3 : 4;
---

<div class="cards-wrap">
  <ul class:list={["cards", `cards--${columns}`]}>
    {
      section.items.map((item, i) => (
        <li class:list={["cards__item", "reveal", { "cards__item--link": Boolean(item.href) }]} style={`--i: ${i}`}>
          {item.image && <ImageSlot image={item.image} class="cards__image" sizes="(min-width: 60rem) 25vw, (min-width: 40rem) 50vw, 100vw" widths={[480, 800]} />}
          <h3 class="cards__title">{item.title}</h3>
          {item.text && <p class="cards__text">{item.text}</p>}
          {
            item.bullets && item.bullets.length > 0 && (
              <ul class="cards__list">
                {item.bullets.map((b) => (
                  <li>{b}</li>
                ))}
              </ul>
            )
          }
          {
            item.href && item.linkLabel && (
              <a class="link cards__link" href={item.href}>
                {item.linkLabel}
                <Icon name="arrow" />
              </a>
            )
          }
        </li>
      ))
    }
  </ul>
  {section.callout && <Callout callout={section.callout} class="cards__callout reveal" />}
</div>

<style>
  .cards-wrap {
    display: grid;
    gap: var(--space-5);
  }
  .cards {
    display: grid;
    gap: var(--space-5);
  }
  .cards__item {
    position: relative;
    display: grid;
    gap: var(--space-3);
    align-content: start;
    justify-items: start;
    padding: var(--space-5);
    border: 1px solid var(--outline-pink);
    border-radius: var(--radius);
    background: var(--tile);
  }
  .cards__item--link {
    background: var(--pale-pink);
    border-color: transparent;
  }
  .cards__item :global(.cards__image) {
    width: 100%;
    margin-bottom: var(--space-2);
  }
  .cards__text {
    color: var(--ink-body);
    max-width: 34ch;
  }
  .cards__list {
    display: grid;
    gap: var(--space-2);
    padding-left: 1.1rem;
    list-style: disc;
    color: var(--ink-body);
    max-width: 34ch;
  }
  .cards__list li::marker {
    color: var(--ink-muted);
  }
  /* The whole tile is the target; the link text is where the eye lands. */
  .cards__link {
    margin-top: auto;
    padding-top: var(--space-2);
  }
  .cards__link::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }
  @media (min-width: 40rem) {
    .cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 60rem) {
    .cards--3 {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .cards--4 {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
    .cards--2 .cards__text,
    .cards--2 .cards__list {
      max-width: 48ch;
    }
  }
</style>
