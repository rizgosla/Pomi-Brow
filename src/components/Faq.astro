---
// Questions, as a grid of cards.
//
// The earlier version put a very large heading and a lede in a sticky left column beside one
// long accordion, which left most of that column empty at every width. The heading now sits
// above, and the questions fill the page two across. The open card takes the studio's pale
// pink with a Pink Ink mark, so the one you are reading is the one thing on the block in colour.
import type { LearnArticle } from "../lib/content";
import Icon from "./Icon.astro";

interface Props {
  /** Learn articles: the title is the question, the summary the short answer, with a link on. */
  faqs?: LearnArticle[];
  /** Or plain questions and answers, as a slide page's own FAQ section carries them. */
  items?: { q: string; a: string; href?: string }[];
  /** Overridable so /faqs, /safety and /aftercare reuse this without forking it. */
  heading?: string;
  lede?: string;
  id?: string;
  /** Hide the "Read the Learn articles" link when the page already is Learn. */
  showLearnLink?: boolean;
}
const {
  faqs = [],
  items,
  heading = "The questions everyone asks first.",
  lede = "Short answers here. Longer ones, with photos, in Learn.",
  id = "questions",
  showLearnLink = true,
} = Astro.props;

// One shape for both sources. The heading id follows the section id so two FAQ blocks on one
// page (a section's own and the site-wide one) never share an id.
const entries = items ?? faqs.map((f) => ({ q: f.title, a: f.summary, href: `/learn/${f.slug}` }));
const headingId = `${id}-heading`;
---

{
  entries.length > 0 && (
    <section class="faq section" id={id} aria-labelledby={headingId}>
      <div class="page">
        <div class="section-head faq__head reveal">
          <h2 id={headingId}>{heading}</h2>
          <p class="lede">{lede}</p>
          {showLearnLink && (
            <a class="link" href="/learn">
              Read the Learn articles
              <Icon name="arrow" />
            </a>
          )}
        </div>

        <div class="faq__grid">
          {entries.map((f, i) => (
            <details class="faq__item reveal" open={i === 0} style={`--i: ${i % 4}`}>
              <summary class="faq__summary">
                <span class="faq__q">{f.q}</span>
                <span class="faq__mark" aria-hidden="true">
                  <Icon name="plus" class="faq__plus" />
                  <Icon name="minus" class="faq__minus" />
                </span>
              </summary>
              <div class="faq__answer">
                <p>{f.a}</p>
                {f.href && (
                  <a class="link" href={f.href}>
                    Full answer
                    <Icon name="arrow" />
                  </a>
                )}
              </div>
            </details>
          ))}
        </div>
      </div>
    </section>
  )
}

<style>
  .faq__head {
    justify-items: start;
  }
  .faq__grid {
    display: grid;
    gap: var(--space-4);
  }
  .faq__item {
    border: 1px solid var(--line-pink);
    border-radius: var(--radius);
    background: var(--canvas);
    transition: background-color var(--dur-base) ease, border-color var(--dur-base) ease;
  }
  .faq__item:hover {
    border-color: var(--line-pink-strong);
  }
  /* The open one is the one filled in colour. */
  .faq__item[open] {
    background: var(--pale-pink);
    border-color: var(--line-pink-strong);
  }
  .faq__summary {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-4);
    min-height: 44px;
    padding: clamp(1.25rem, 1rem + 1vw, 1.75rem);
    cursor: pointer;
    list-style: none;
    font-weight: 500;
    color: var(--ink);
  }
  .faq__summary::-webkit-details-marker {
    display: none;
  }
  .faq__q {
    font-size: var(--fs-body);
    line-height: 1.4;
  }
  .faq__mark {
    flex: 0 0 auto;
    display: inline-flex;
    margin-top: 0.15em;
    color: var(--ink-muted);
  }
  .faq__item[open] .faq__mark {
    color: var(--pink-ink);
  }
  .faq :global(.faq__plus),
  .faq :global(.faq__minus) {
    width: 1.1rem;
    height: 1.1rem;
  }
  .faq__item[open] :global(.faq__plus),
  .faq__item:not([open]) :global(.faq__minus) {
    display: none;
  }
  .faq__answer {
    display: grid;
    gap: var(--space-3);
    justify-items: start;
    padding: 0 clamp(1.25rem, 1rem + 1vw, 1.75rem) clamp(1.25rem, 1rem + 1vw, 1.75rem);
    color: var(--ink-body);
  }
  .faq__answer p {
    max-width: 58ch;
  }
  @media (min-width: 60rem) {
    .faq__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      align-items: start;
    }
  }
</style>
