---
import type { LearnArticle } from "../lib/content";
import Icon from "./Icon.astro";

interface Props {
  faqs: LearnArticle[];
}
const { faqs } = Astro.props;
---

{
  faqs.length > 0 && (
    <section class="faq section" id="questions" aria-labelledby="faq-heading">
      <div class="page faq__grid">
        <div class="faq__intro reveal">
          <h2 id="faq-heading">The questions everyone asks first.</h2>
          <p class="lede">Short answers here. Longer ones, with photos, in Learn.</p>
          <a class="link" href="/learn">
            Read the Learn articles
            <Icon name="arrow" />
          </a>
        </div>
        <div class="faq__list reveal" style="--i: 1">
          {faqs.map((f, i) => (
            <details class="faq__item" open={i === 0}>
              <summary>
                <span>{f.title}</span>
                <span class="faq__mark" aria-hidden="true">
                  <Icon name="plus" class="faq__plus" />
                  <Icon name="minus" class="faq__minus" />
                </span>
              </summary>
              <div class="faq__answer">
                <p>{f.summary}</p>
                <a class="link" href={`/learn/${f.slug}`}>
                  Full answer
                  <Icon name="arrow" />
                </a>
              </div>
            </details>
          ))}
        </div>
      </div>
    </section>
  )
}

<style>
  .faq__grid {
    display: grid;
    gap: var(--space-8);
  }
  .faq__intro {
    display: grid;
    gap: var(--space-4);
    align-content: start;
  }
  .faq__item {
    border-bottom: 1px solid var(--border);
  }
  .faq__item summary {
    list-style: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding: 1.1rem 0;
    font-size: 1.0625rem;
    font-weight: 500;
    color: var(--ink);
    line-height: 1.35;
  }
  .faq__item summary::-webkit-details-marker {
    display: none;
  }
  .faq__mark {
    display: inline-grid;
    place-items: center;
    flex: 0 0 auto;
    color: var(--ink-muted);
  }
  .faq__mark :global(.icon) {
    width: 1rem;
    height: 1rem;
    grid-area: 1 / 1;
  }
  .faq__mark :global(.faq__minus) {
    display: none;
  }
  .faq__item[open] .faq__mark :global(.faq__plus) {
    display: none;
  }
  .faq__item[open] .faq__mark :global(.faq__minus) {
    display: block;
  }
  .faq__answer {
    padding: 0 0 1.4rem;
    display: grid;
    gap: var(--space-4);
    color: var(--ink-muted);
    max-width: 58ch;
  }
  @media (min-width: 60rem) {
    .faq__grid {
      grid-template-columns: 2fr 3fr;
      gap: var(--space-9);
    }
    .faq__intro {
      position: sticky;
      top: calc(var(--header-h) + var(--space-6));
    }
  }
</style>
