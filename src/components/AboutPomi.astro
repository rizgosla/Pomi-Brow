---
import type { SiteSettings, Service, Photo as PhotoType } from "../lib/content";
import { photoCaption } from "../lib/content";
import Photo from "./Photo.astro";
import Caption from "./Caption.astro";
import Icon from "./Icon.astro";

interface Props {
  settings: SiteSettings;
  services: Service[];
  /** Shown until a real headshot is supplied in Site settings. */
  fallbackPhoto: PhotoType | null;
}
const { settings, services, fallbackPhoto } = Astro.props;
const photo = settings.headshot ?? fallbackPhoto;
const isHeadshot = Boolean(settings.headshot);
// Caption comes from the photograph, so swapping the fallback image cannot leave a stale label.
const cap = photo && !isHeadshot ? photoCaption(photo, services) : null;
// Until a real bio is supplied the section degrades to the photograph and the
// link, rather than printing scaffolding where the page asks for trust.
const bio = settings.bio.filter((p) => !/placeholder/i.test(p));
---

<section class="about section" id="about" aria-labelledby="about-heading">
  <div class="page about__grid">
    {/* Heading, the bio at lede size, then the Yelp count folded into one sentence on a
        hairline, then one row of links. Chosen in live mode over a proof-first stack and a
        framed proof card: one compact statement reads faster beside the photograph. */}
    <div class="about__copy reveal">
      <h2 id="about-heading">{settings.aboutHeading}</h2>
      {bio.length > 0 && <div class="about__bio">{bio.map((p) => <p>{p}</p>)}</div>}
      <p class="about__proof">
        <span class="about__num">{settings.yelpReviewCount}+</span>
        five-star reviews on Yelp, every one written by a client of one artist. Read them before you call.
      </p>
      <div class="about__links">
        <a class="link" href={settings.yelpUrl} rel="noopener">
          Read the reviews
          <Icon name="external" />
        </a>
        <a class="link" href="/about">
          More about Pomi
          <Icon name="arrow" />
        </a>
        <a class="link" href={settings.instagramUrl} rel="noopener">
          <Icon name="instagram" />
          @{settings.instagramHandle}
        </a>
      </div>
    </div>
    {
      photo && (
        <figure class="about__figure reveal" style="--i: 1">
          <Photo photo={photo} sizes="(min-width: 60rem) 36vw, 100vw" widths={[640, 960]} ratio="4 / 5" />
          <figcaption>
            <Caption
              service={isHeadshot ? "Pomi" : (cap?.service ?? "Pomi B. Brow Studio")}
              detail={isHeadshot ? "Permanent makeup artist" : (cap?.detail ?? "Healed, by Pomi")}
            />
          </figcaption>
        </figure>
      )
    }
  </div>
</section>

<style>
  .about__grid {
    display: grid;
    gap: var(--space-8);
    align-items: center;
  }
  /* The copy starts at the page edge like every other section's, and each text block
     carries its own measure; the column itself is not capped. Snug rhythm: one statement,
     not a stack of blocks. */
  .about__copy {
    display: grid;
    gap: var(--space-4);
    align-content: center;
  }
  .about__bio {
    color: var(--ink-body);
    max-width: 52ch;
    font-size: var(--fs-lede);
    line-height: 1.5;
  }
  .about__proof {
    margin: 0;
    padding-top: var(--space-4);
    border-top: 1px solid var(--border);
    color: var(--ink-body);
    max-width: 52ch;
  }
  /* The count set large in the line, in the brow pigment: the number is about the work,
     so it carries the work's colour rather than the neutral ink. */
  .about__num {
    font-family: var(--font-display);
    font-variation-settings: "opsz" 72;
    font-weight: 400;
    font-size: 1.6em;
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--pigment-brow);
    font-variant-numeric: tabular-nums;
    margin-right: 0.15em;
  }
  .about__links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-5);
  }
  .about__links .link {
    min-height: 44px;
  }
  .about__figure {
    margin: 0;
  }
  @media (min-width: 60rem) {
    /* Same split as the hero: text leads, 1.1fr / 1fr, so the heading and the
       Instagram grid above share one left edge. */
    .about__grid {
      grid-template-columns: 1.1fr 1fr;
      column-gap: var(--space-8);
    }
  }
</style>
