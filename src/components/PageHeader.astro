---
// The subpage counterpart to Hero.astro, which hard-codes the home headline and cannot be reused.
// Title, one lede, an optional meta line on a hairline, and an optional tag above nothing --
// the tag sits beside the meta, never above the heading, because a kicker over a heading is banned.
import Icon from "./Icon.astro";

interface Props {
  title: string;
  lede?: string;
  meta?: string;
  /** Breadcrumb-style parent link, e.g. { href: "/learn", label: "Learn" }. */
  parent?: { href: string; label: string };
  class?: string;
}
const { title, lede, meta, parent, class: className } = Astro.props;
---

<header class:list={["pagehead", className]}>
  <div class="page pagehead__inner">
    {
      parent && (
        <a class="pagehead__parent link" href={parent.href}>
          <Icon name="arrow" class="pagehead__back" />
          {parent.label}
        </a>
      )
    }
    <h1>{title}</h1>
    {lede && <p class="lede">{lede}</p>}
    {
      meta && (
        <p class="pagehead__meta">
          <span>{meta}</span>
        </p>
      )
    }
  </div>
</header>

<style>
  .pagehead {
    padding-block: var(--space-7) var(--space-8);
  }
  .pagehead__inner {
    display: grid;
    gap: var(--space-5);
    justify-items: start;
  }
  .pagehead h1 {
    max-width: 20ch;
  }
  .pagehead .lede {
    max-width: 46ch;
  }
  .pagehead__parent {
    color: var(--ink-muted);
  }
  .pagehead__parent :global(.pagehead__back) {
    width: 1rem;
    height: 1rem;
    transform: rotate(180deg);
  }
  .pagehead__meta {
    width: 100%;
    padding-top: var(--space-4);
    border-top: 1px solid var(--border);
    font-size: var(--fs-caption);
    color: var(--ink-muted);
  }
  .pagehead__meta span {
    display: block;
    max-width: 60ch;
  }
  @media (min-width: 60rem) {
    .pagehead {
      padding-block: var(--space-8) var(--space-9);
    }
  }
</style>
