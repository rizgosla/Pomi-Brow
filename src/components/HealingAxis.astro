---
// The method and the healing timeline: six moments along one pigment rail, from mapping to the
// six-week touch-up. Horizontal on desktop so the whole six weeks reads in one glance; it was a
// tall vertical list beside a large photograph and cost more than a screen. Phones keep the
// vertical rail, since six columns do not fit 390px.

const steps = [
  {
    when: "Before pigment",
    dot: "var(--heal-0)",
    ring: "var(--ink-muted)",
    title: "Mapped and measured",
    body: "Pomi draws the shape on with pencil and thread first: head, arch, tail, measured against your own features. Nothing is permanent until you agree with what you see in the mirror.",
  },
  {
    when: "Day 1",
    dot: "var(--heal-1)",
    ring: "var(--heal-1)",
    title: "Bolder than the final",
    body: "Fresh work looks darker and sharper than it will heal. This is normal and it is temporary.",
  },
  {
    when: "Days 4 to 7",
    dot: "var(--heal-2)",
    ring: "var(--heal-2)",
    title: "Flaking",
    body: "The surface flakes as the skin heals. Keep it dry and leave it alone; the color underneath is setting.",
  },
  {
    when: "Around day 10",
    dot: "var(--heal-3)",
    ring: "var(--heal-4)",
    title: "Too light",
    body: "The color looks like it disappeared. It has not. It is under a new layer of skin and will come back.",
  },
  {
    when: "Week 4",
    dot: "var(--heal-4)",
    ring: "var(--heal-4)",
    title: "The true color",
    body: "Healed skin turns clear and the real shade shows, softer and more natural than day one.",
  },
  {
    when: "Week 6",
    dot: "var(--pink-ink)",
    ring: "var(--pink-ink)",
    title: "The perfecting touch-up",
    body: "Skin heals unevenly, so some strokes need a second pass. This appointment refines shape and color and finishes the work. It is part of the service, not an extra.",
    last: true,
  },
];
---

<section class="method section" id="method" aria-labelledby="method-heading">
  <div class="page">
    <div class="section-head reveal">
      <h2 id="method-heading">Precision first. Then six weeks of patience.</h2>
      <p class="lede">
        Natural is not luck. It is measured before a single stroke, then given time to heal into your skin.
      </p>
    </div>

    <ol class="axis">
      {
        steps.map((s, i) => (
          <li class:list={["axis__step", "reveal", { "axis__step--last": s.last }]} style={`--i: ${i}; --dot: ${s.dot}; --dot-ring: ${s.ring}`}>
            <span class:list={["tag", { "tag--pink": s.last }]}>{s.when}</span>
            <h3 class="axis__title">{s.title}</h3>
            <p class="axis__body">{s.body}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  /* The hero is not a .section, so the shared section rule never fires above this one.
     It is drawn here instead: full width, and -- because the hero is exactly one screen
     -- exactly on the fold, closing the first screen without showing on first load. */
  .method {
    border-top: 1px solid var(--border);
  }

  /* Phone: a vertical rail down the left edge. */
  .axis {
    position: relative;
    padding-left: 2rem;
  }
  .axis::before {
    content: "";
    position: absolute;
    left: 0.4rem;
    top: 0.5rem;
    bottom: 0.5rem;
    width: 5px;
    border-radius: 3px;
    /* The pigment across six weeks: dense, flaking, washed out around day ten,
       returning, settled. The rail is the argument, made in colour. */
    background: linear-gradient(
      to bottom,
      var(--heal-0) 0%,
      var(--heal-1) 14%,
      var(--heal-2) 34%,
      var(--heal-3) 55%,
      var(--heal-4) 78%,
      var(--heal-5) 100%
    );
  }
  .axis__step {
    position: relative;
    display: grid;
    gap: var(--space-2);
    justify-items: start;
    align-content: start;
    padding-bottom: var(--space-5);
  }
  .axis__step::before {
    content: "";
    position: absolute;
    left: calc(-2rem + 0.4rem - 3px);
    top: 0.45rem;
    width: 11px;
    height: 11px;
    border-radius: 50%;
    /* Each dot is filled at that moment's pigment value. The day-ten dot is
       deliberately the palest thing on the page -- that is the point of it --
       so every dot carries a ring to stay perceivable at 11px. */
    background: var(--dot, var(--canvas));
    border: 1px solid var(--dot-ring, var(--ink-muted));
    box-shadow: 0 0 0 3px var(--canvas);
  }
  .axis__step--last::before {
    background: var(--pink-ink);
    border-color: var(--pink-ink);
  }
  .axis__step--last {
    padding-bottom: 0;
  }
  .axis__body {
    color: var(--ink-muted);
    max-width: 58ch;
  }
  .method :global(.section-head h2) {
    max-width: 30ch;
  }
  .method :global(.section-head .lede) {
    max-width: 52ch;
  }

  /* Desktop: the rail runs left to right across six columns, each dot sitting on it at
     the head of its step. The rail stops at the Week 6 dot rather than running on under
     the last column, and its stops land on the dots: step n sits at n/5 of the rail. */
  @media (min-width: 60rem) {
    .axis {
      --rail-gap: var(--space-5);
      display: grid;
      grid-template-columns: repeat(6, minmax(0, 1fr));
      column-gap: var(--rail-gap);
      padding-left: 0;
      padding-top: 2.25rem;
    }
    .axis::before {
      top: 0.4rem;
      bottom: auto;
      left: 3px;
      right: calc((100% - 5 * var(--rail-gap)) / 6 - 8px);
      width: auto;
      height: 5px;
      background: linear-gradient(
        to right,
        var(--heal-0) 0%,
        var(--heal-1) 20%,
        var(--heal-2) 40%,
        var(--heal-3) 60%,
        var(--heal-4) 80%,
        var(--heal-5) 100%
      );
    }
    .axis__step {
      padding-bottom: 0;
    }
    .axis__step::before {
      left: 0;
      top: calc(0.4rem - 3px - 2.25rem);
    }
    .axis__body {
      font-size: var(--fs-small);
      max-width: none;
    }
  }
</style>
