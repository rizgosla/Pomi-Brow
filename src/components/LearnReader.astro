---
// One article in the Learn shell: the list of titles on the left, the article on the right.
// Used by /learn (which shows the first article) and by /learn/[slug], so the section has one
// layout and one set of decisions.
//
// No buttons. Learn informs; the header and the pinned mobile bar carry the call everywhere.
import type { LearnArticle, Service, SiteSettings } from "../lib/content";
import LearnNav from "./LearnNav.astro";
import PageHeader from "./PageHeader.astro";
import PortableText from "./PortableText.astro";
import Photo from "./Photo.astro";
import Caption from "./Caption.astro";

interface Props {
  article: LearnArticle;
  learn: LearnArticle[];
  services: Service[];
  settings: SiteSettings;
}
const { article, learn, services } = Astro.props;

const service = services.find((s) => s.slug === article.relatedService);
const hasBody = Boolean(article.body && article.body.length > 0);
---

<PageHeader title={article.title} lede={article.summary} parent={{ href: "/learn", label: "Learn" }} />

<section class="section reader">
  <div class="page reader__grid">
    <aside class="reader__aside">
      <LearnNav articles={learn} current={article.slug} heading="All articles" />
    </aside>

    <div class="reader__body">
      {
        article.cover && (
          <figure class="reader__lead">
            <Photo
              photo={article.cover}
              ratio="5 / 2"
              loading="eager"
              fetchpriority="high"
              widths={[700, 1100, 1320]}
              sizes="(min-width: 60rem) 70vw, 100vw"
            />
            <figcaption>
              <Caption
                service={service ? service.title : "Pomi B. Brow Studio"}
                detail={article.cover.detail ?? "Healed"}
              />
            </figcaption>
          </figure>
        )
      }

      {
        hasBody && (
          <div class="reader__article reveal">
            <h2 class="visually-hidden">{article.title}</h2>
            <PortableText blocks={article.body} dropcap />
          </div>
        )
      }

      {
        service && (
          <p class="reader__related">
            Related service: <a href={`/services/${service.slug}`}>{service.title}</a>
          </p>
        )
      }
    </div>
  </div>
</section>

<style>
  .reader__grid {
    display: grid;
    gap: var(--space-7);
    align-items: start;
  }
  .reader__body {
    display: grid;
    gap: var(--space-8);
    min-width: 0;
  }
  .reader__lead {
    margin: 0;
  }
  .reader__related {
    padding-top: var(--space-6);
    border-top: 1px solid var(--border);
    font-size: var(--fs-small);
    color: var(--ink-muted);
  }
  .reader__related a {
    color: var(--ink);
    font-weight: 500;
    text-decoration: underline;
    text-decoration-color: var(--border);
    text-underline-offset: 0.25em;
    text-decoration-thickness: 1px;
  }
  .reader__related a:hover {
    text-decoration-color: currentColor;
  }
  @media (min-width: 60rem) {
    .reader__grid {
      grid-template-columns: 18rem 1fr;
      column-gap: var(--space-9);
    }
  }
</style>
