---
import type { SiteSettings, Service } from "../lib/content";
import { getLearnArticles } from "../lib/content";
import Icon from "./Icon.astro";
import logo from "../assets/brand/logo-mark-black.svg?raw";

interface Props {
  settings: SiteSettings;
  services: Service[];
}
const { settings, services } = Astro.props;
const year = new Date().getFullYear();
const servicePages = services.filter((s) => ["Eyebrows", "Eyes", "Lips", "Hair"].includes(s.category));
// Driven from the content layer rather than a hard-coded list, so a new article in
// Sanity appears here without a code change.
const articles = await getLearnArticles();
const learn = articles.slice(0, 5).map((a) => ({ label: a.title, href: `/learn/${a.slug}` }));
---

<footer class="footer">
  <div class="page">
    <div class="footer__grid">
      <div class="footer__brand-col">
        <a class="footer__brand" href="/" aria-label={`${settings.businessName} home`}>
          <span class="footer__logo" set:html={logo} />
        </a>
        <address class="footer__address">
          {settings.street}<br />
          {settings.city}, {settings.state} {settings.zip}
        </address>
        <p class="footer__meta">
          <a href={`tel:${settings.phoneTel}`}>{settings.phone}</a>
          <span class="footer__dot" aria-hidden="true">·</span>
          {settings.hours.length > 0
            ? settings.hours.map((h) => `${h.days} ${h.opens}–${h.closes}`).join(", ")
            : settings.hoursNote}
        </p>
        <div class="footer__social">
          <a href={settings.instagramUrl} rel="noopener">
            <Icon name="instagram" />
            @{settings.instagramHandle}
          </a>
          <a href={settings.yelpUrl} rel="noopener">
            <Icon name="yelp" />
            Yelp
          </a>
          <a href={settings.mapLinkUrl} rel="noopener">
            <Icon name="pin" />
            Directions
          </a>
        </div>
      </div>

      <div>
        <p class="footer__head">Services</p>
        <ul class="footer__list">
          {servicePages.map((s) => (
            <li>
              <a href={`/services/${s.slug}`}>{s.title}</a>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <p class="footer__head">Learn</p>
        <ul class="footer__list">
          {learn.map((l) => (
            <li>
              <a href={l.href}>{l.label}</a>
            </li>
          ))}
          <li><a href="/about">About Pomi</a></li>
          <li><a href="/aftercare">Aftercare</a></li>
        </ul>
      </div>
    </div>

    <div class="footer__bottom">
      <p>© {year} {settings.businessName}. Prices subject to change.</p>
      <p>Permanent makeup in Tustin, serving Irvine and Orange County.</p>
    </div>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--border);
    padding-block: var(--space-9) var(--space-6);
    color: var(--ink-muted);
    font-size: var(--fs-small);
  }
  .footer__grid {
    display: grid;
    gap: var(--space-7) var(--space-6);
  }
  .footer__brand {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    margin-bottom: var(--space-5);
  }
  .footer__logo :global(svg) {
    height: 2.5rem;
    width: auto;
  }
  .footer__address {
    font-style: normal;
    color: var(--ink-body);
  }
  .footer__meta {
    margin-top: var(--space-2);
  }
  .footer__meta a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--pink-ink);
    text-decoration: none;
    font-variant-numeric: tabular-nums;
  }
  .footer__dot {
    margin-inline: 0.5rem;
  }
  .footer__social {
    margin-top: var(--space-4);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
  }
  .footer__social a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    gap: 0.4rem;
    text-decoration: none;
    color: var(--ink);
    font-weight: 500;
  }
  .footer__social :global(.icon) {
    width: 1rem;
    height: 1rem;
  }
  .footer__head {
    margin-bottom: var(--space-3);
    color: var(--ink);
    font-weight: 500;
  }
  .footer__list {
    display: grid;
  }
  .footer__list a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    text-decoration: none;
  }
  .footer__list a:hover {
    color: var(--ink);
  }
  .footer__bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-2) var(--space-5);
    margin-top: var(--space-8);
    padding-top: var(--space-5);
    border-top: 1px solid var(--border);
    font-size: var(--fs-caption);
  }
  .footer__bottom p + p {
    margin: 0;
  }
  @media (min-width: 48rem) {
    .footer__grid {
      grid-template-columns: 1.6fr 1fr 1fr;
    }
  }
</style>
