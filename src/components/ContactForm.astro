---
// The contact form plus the studio's location. Submissions go to a Cloudflare Pages Function, never to Sanity.
import type { SiteSettings, Service } from "../lib/content";
import Icon from "./Icon.astro";

interface Props {
  settings: SiteSettings;
  services: Service[];
}
const { settings, services } = Astro.props;
const options = services.filter((s) => ["Eyebrows", "Eyes", "Lips", "Hair"].includes(s.category));
---

<section class="contact section" id="contact" aria-labelledby="contact-heading">
  <div class="page contact__grid">
    <div class="contact__form-col reveal">
      <div class="section-head" style="margin-bottom: var(--space-6)">
        <h2 id="contact-heading">Ask Pomi anything.</h2>
        <p class="lede">
          Not sure which service fits, or whether it will look natural on you? Send a note or call. Pomi answers herself.
        </p>
      </div>

      <form class="form" method="post" action="/api/contact" data-contact-form novalidate>
        <div class="form__row">
          <label class="form__field">
            <span class="form__label">Your name</span>
            <input type="text" name="name" autocomplete="name" required />
          </label>
          <label class="form__field">
            <span class="form__label">Phone</span>
            <input type="tel" name="phone" autocomplete="tel" inputmode="tel" required />
          </label>
        </div>
        <label class="form__field">
          <span class="form__label">Email <span class="form__optional">optional</span></span>
          <input type="email" name="email" autocomplete="email" inputmode="email" />
        </label>
        <label class="form__field">
          <span class="form__label">Interested in</span>
          <span class="form__select">
            <select name="service">
              <option value="">Not sure yet</option>
              {options.map((s) => <option value={s.slug}>{s.title}</option>)}
              <option value="touch-up">A touch-up on existing work</option>
              <option value="removal">Removal or correction</option>
            </select>
          </span>
        </label>
        <label class="form__field">
          <span class="form__label">Your question</span>
          <textarea name="message" rows="4" required></textarea>
        </label>
        <label class="form__trap" aria-hidden="true">
          Leave this empty
          <input type="text" name="website" tabindex="-1" autocomplete="off" />
        </label>

        <p class="form__status" role="status" aria-live="polite" data-status hidden></p>

        <div class="form__actions">
          <button class="btn" type="submit" data-submit>
            <span data-submit-label>Send to Pomi</span>
            <Icon name="arrow" />
          </button>
          <p class="form__aside">
            Or call <a href={`tel:${settings.phoneTel}`}>{settings.phone}</a>
          </p>
        </div>
      </form>
    </div>

    <div class="contact__where reveal" style="--i: 1">
      <div class="card contact__card">
        <p class="contact__head">The studio</p>
        <address class="contact__address">
          <strong>{settings.businessName}</strong><br />
          {settings.street}<br />
          {settings.city}, {settings.state} {settings.zip}
        </address>
        <p class="muted">{settings.locationLine}.</p>
        <p class="muted">
          {
            settings.hours.length > 0
              ? settings.hours.map((h) => (
                  <span>
                    {h.days}: {h.opens}–{h.closes}
                    <br />
                  </span>
                ))
              : settings.hoursNote
          }
        </p>
        <div class="contact__map">
          <iframe
            src={settings.mapEmbedUrl}
            title={`Map to ${settings.businessName}`}
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            allowfullscreen
          ></iframe>
        </div>
        <a class="link" href={settings.mapLinkUrl} rel="noopener">
          <Icon name="pin" />
          Directions in Google Maps
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .contact__grid {
    display: grid;
    gap: var(--space-8);
  }
  .form {
    display: grid;
    gap: var(--space-5);
  }
  .form__row {
    display: grid;
    gap: var(--space-5);
  }
  .form__field {
    display: grid;
    gap: 0.4rem;
  }
  .form__label {
    font-size: var(--fs-caption);
    font-weight: 500;
    color: var(--ink);
  }
  .form__optional {
    font-weight: 400;
    color: var(--ink-muted);
    margin-left: 0.35em;
  }
  .form input,
  .form textarea,
  .form select {
    width: 100%;
    font: inherit;
    color: var(--ink);
    background: var(--canvas);
    border: 1px solid var(--line-pink);
    border-radius: var(--radius-sm);
    padding: 0.7rem 0.85rem;
    transition:
      border-color var(--dur-fast) ease,
      box-shadow var(--dur-fast) ease;
  }
  .form input::placeholder,
  .form textarea::placeholder {
    color: var(--ink-muted);
  }
  .form input:focus-visible,
  .form textarea:focus-visible,
  .form select:focus-visible {
    outline: none;
    border-color: var(--pink-ink);
    box-shadow: 0 0 0 3px rgba(196, 42, 102, 0.12);
  }
  .form textarea {
    resize: vertical;
    min-height: 7rem;
  }
  .form__select {
    position: relative;
    display: block;
  }
  .form select {
    appearance: none;
    padding-right: 2.25rem;
    cursor: pointer;
  }
  .form__select::after {
    content: "";
    position: absolute;
    right: 0.95rem;
    top: 50%;
    width: 0.5rem;
    height: 0.5rem;
    border-right: 1.5px solid var(--ink-muted);
    border-bottom: 1.5px solid var(--ink-muted);
    transform: translateY(-70%) rotate(45deg);
    pointer-events: none;
  }
  .form__trap {
    position: absolute;
    left: -10000px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
  .form__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-5);
    margin-top: var(--space-2);
  }
  .form__aside {
    font-size: var(--fs-small);
    color: var(--ink-muted);
  }
  .form__aside a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-weight: 500;
    color: var(--pink-ink);
    text-decoration: none;
    font-variant-numeric: tabular-nums;
  }
  .form__status {
    padding: 0.75rem 0.85rem;
    border: 1px solid var(--line-pink);
    border-radius: var(--radius-sm);
    background: var(--pale-green);
    color: var(--pale-green-ink);
    font-size: var(--fs-small);
  }
  .form__status[data-tone="error"] {
    background: var(--pale-red);
    color: var(--pale-red-ink);
  }
  .form__status,
  .form [data-submit] {
    scroll-margin-bottom: calc(var(--callbar-h) + 1.5rem);
  }
  .form[data-state="submitting"] [data-submit] {
    opacity: 0.6;
    pointer-events: none;
  }
  .form :is(input, textarea)[aria-invalid="true"] {
    border-color: var(--pale-red-ink);
  }

  .contact__card {
    display: grid;
    gap: var(--space-3);
    align-content: start;
  }
  .contact__head {
    font-weight: 500;
    color: var(--ink);
  }
  .contact__address {
    font-style: normal;
    line-height: 1.5;
    color: var(--ink-body);
  }
  .contact__map {
    aspect-ratio: 4 / 3;
    margin-top: var(--space-2);
    border: 1px solid var(--line-pink);
    border-radius: var(--radius-sm);
    overflow: hidden;
    background: var(--surface);
  }
  .contact__map iframe {
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
  }
  @media (min-width: 40rem) {
    .form__row {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (min-width: 60rem) {
    .contact__grid {
      grid-template-columns: 3fr 2fr;
      gap: var(--space-9);
    }
  }
</style>

<script>
  const form = document.querySelector<HTMLFormElement>("[data-contact-form]");
  if (form) {
    const status = form.querySelector<HTMLElement>("[data-status]")!;
    const label = form.querySelector<HTMLElement>("[data-submit-label]")!;
    const say = (text: string, tone: "ok" | "error") => {
      status.textContent = text;
      status.dataset.tone = tone;
      status.hidden = false;
    };

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const fields = Array.from(form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>("[required]"));
      let firstBad: HTMLElement | null = null;
      for (const f of fields) {
        const bad = !f.value.trim() || (f.type === "email" && !f.checkValidity());
        f.setAttribute("aria-invalid", String(bad));
        if (bad && !firstBad) firstBad = f;
      }
      if (firstBad) {
        say("A name, a phone number, and your question are all we need.", "error");
        firstBad.focus();
        return;
      }

      form.dataset.state = "submitting";
      label.textContent = "Sending";
      status.hidden = true;
      const data = Object.fromEntries(new FormData(form).entries());

      try {
        const res = await fetch(form.action, {
          method: "POST",
          headers: { "Content-Type": "application/json", Accept: "application/json" },
          body: JSON.stringify(data),
        });
        const body = await res.json().catch(() => ({}));
        if (res.ok && body.ok) {
          form.reset();
          label.textContent = "Sent";
          say("Sent. Pomi will get back to you, usually the same day.", "ok");
        } else {
          throw new Error(body.error || "not-sent");
        }
      } catch {
        label.textContent = "Send to Pomi";
        say("That did not go through. Please call the studio instead; the number is right here.", "error");
      } finally {
        delete form.dataset.state;
      }
    });
  }
</script>
