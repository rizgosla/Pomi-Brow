---
// A small hand-drawn icon set at one standardized 2px stroke. Never emoji, never a font.
interface Props {
  name: "phone" | "arrow" | "instagram" | "yelp" | "pin" | "star" | "menu" | "close" | "external" | "plus" | "minus";
  class?: string;
  title?: string;
}
const { name, class: className, title } = Astro.props;

const paths: Record<Props["name"], string> = {
  phone:
    '<path d="M6.5 3.5h3l1.5 4-2 1.3a11 11 0 0 0 6.2 6.2l1.3-2 4 1.5v3a2 2 0 0 1-2 2A15.5 15.5 0 0 1 4.5 5.5a2 2 0 0 1 2-2Z"/>',
  arrow: '<path d="M4 12h15"/><path d="m13 6 6 6-6 6"/>',
  instagram:
    '<rect x="3.5" y="3.5" width="17" height="17" rx="4.5"/><circle cx="12" cy="12" r="3.8"/><circle cx="17.2" cy="6.8" r="1" fill="currentColor" stroke="none"/>',
  // The Yelp burst: five rays fanning from a centre gap. The previous version's first path
  // was malformed -- "M11.2 3.2 12 11 l-4.6-6.4" draws a chevron, not a ray -- so the mark
  // rendered as a lopsided asterisk everywhere it appeared. Rays are widened past the set's
  // 2px so the burst reads as a shape rather than scratches at 16px, and stay in currentColor:
  // Yelp red would break both the icon rule and the accent rule.
  yelp:
    '<path stroke-width="4.4" d="M10.6 5.6v3.5"/><path stroke-width="4.4" d="M17.4 9.5l-2.9 1.7"/><path stroke-width="4.4" d="M17.6 16.6l-3.1-1.4"/><path stroke-width="4.4" d="M11.6 18.6v-2.9"/><path stroke-width="4.4" d="M5.8 14.4l3.2-1.2"/>',
  pin: '<path d="M12 21s-6.5-6.2-6.5-11a6.5 6.5 0 0 1 13 0c0 4.8-6.5 11-6.5 11Z"/><circle cx="12" cy="10" r="2.3"/>',
  // Solid rather than stroked: five outlined stars at 1rem read as noise, and a rating has
  // to be countable at a glance. It stays in currentColor -- no gold, no Yelp red -- so it
  // borrows the ink it sits in rather than introducing a hue. Precedent: the Instagram lens.
  star: '<path d="M12 3.6l2.55 5.17 5.7.83-4.13 4.02.98 5.68L12 16.62l-5.1 2.68.98-5.68L3.75 9.6l5.7-.83Z" fill="currentColor" stroke="none"/>',
  menu: '<path d="M4 7h16"/><path d="M4 12h16"/><path d="M4 17h16"/>',
  close: '<path d="m6 6 12 12"/><path d="m18 6-12 12"/>',
  external: '<path d="M14 5h5v5"/><path d="M19 5 10 14"/><path d="M17 13v6H5V7h6"/>',
  plus: '<path d="M12 5v14"/><path d="M5 12h14"/>',
  minus: '<path d="M5 12h14"/>',
};
---

<svg
  class:list={["icon", className]}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden={title ? undefined : "true"}
  role={title ? "img" : undefined}
  set:html={(title ? `<title>${title}</title>` : "") + paths[name]}
/>
