---
import Base from "../layouts/Base.astro";
import PageHeader from "../components/PageHeader.astro";
import Faq from "../components/Faq.astro";
import ContactForm from "../components/ContactForm.astro";
import { getSiteSettings, getServices, getLearnArticles } from "../lib/content";

const [settings, services, learn] = await Promise.all([getSiteSettings(), getServices(), getLearnArticles()]);
// The whole Learn set, not just the home-page subset: this is the page people come to with a question.
const faqs = learn;
const schemaFaqs = learn.filter((a) => a.showAsFaq);
---

<Base
  title={`Permanent makeup FAQ | ${settings.businessName}`}
  description="Answers to the questions people ask before booking permanent makeup: safety, healing, how long it lasts, who it suits, and how to prepare."
  settings={settings}
  services={services}
  faqs={schemaFaqs}
  canonicalPath="/faqs"
>
  <PageHeader
    title="Questions."
    lede="Everything people ask before a first appointment, answered in one place."
    meta="If your question is not here, call and ask. Pomi answers her own phone."
  />

  <Faq
    faqs={faqs}
    id="all"
    heading="Asked and answered."
    lede="Short answers here. The longer ones, with photographs, are in Learn."
  />

  <ContactForm settings={settings} services={services} />
</Base>
