---
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import PricingTable from "../components/PricingTable.astro";
import HealingAxis from "../components/HealingAxis.astro";
import AboutPomi from "../components/AboutPomi.astro";
import Reviews from "../components/Reviews.astro";
import InstagramGrid from "../components/InstagramGrid.astro";
import Faq from "../components/Faq.astro";
import ContactForm from "../components/ContactForm.astro";
import { getSiteSettings, getServices, getReviews, getLearnArticles, localPhoto } from "../lib/content";

const [settings, services, reviews, learn] = await Promise.all([
  getSiteSettings(),
  getServices(),
  getReviews(),
  getLearnArticles(),
]);

const faqs = learn.filter((l) => l.showAsFaq).slice(0, 5);
// The hero wall. Nine healed results, all four categories, ordered so the three
// columns read 5-4-3 / 3-5-4 / 4-3-5 down the 12-row grid -- no tile edge meets
// its neighbour's. Wide cells (span 3) go to eyeliner, lash and lip work, which
// are horizontal subjects; brows and scalp take the squarer cells. Crop focus is
// set per tile because every source is square and the subject sits high in frame.
const heroTileSpecs = [
  // --- first five also serve the phone, one per category ---
  {
    ref: "microblading-shading/01",
    col: 1,
    row: 6,
    span: 4,
    focus: "50% 45%",
    alt: "Healed microblading and shading on both brows, by Pomi",
  },
  {
    ref: "eyeliner/01",
    col: 1,
    row: 10,
    span: 3,
    focus: "50% 30%",
    alt: "Healed permanent eyeliner along the upper lash line",
  },
  {
    ref: "lip-tint/03",
    col: 1,
    row: 1,
    span: 5,
    focus: "50% 50%",
    alt: "Lip tint before and after: the natural lip above, the healed colour below",
  },
  {
    ref: "scalp-micropigmentation/01",
    col: 3,
    row: 8,
    span: 5,
    focus: "50% 50%",
    alt: "Scalp micropigmentation before and after along the hairline",
  },
  {
    ref: "ombre-powder-brows/02",
    col: 2,
    row: 9,
    span: 4,
    focus: "50% 40%",
    alt: "Healed ombre powder brows with a soft gradient",
  },

  // --- desktop only ---
  {
    ref: "lash-enhancement/01",
    col: 2,
    row: 4,
    span: 5,
    focus: "50% 50%",
    alt: "Lash enhancement before and after, a fine line set between the lashes",
  },
  {
    ref: "microblading/01",
    col: 3,
    row: 1,
    span: 4,
    focus: "50% 45%",
    alt: "Healed microblading on both brows, six weeks after the touch-up",
  },
  {
    ref: "microblading/05",
    col: 2,
    row: 1,
    span: 3,
    focus: "50% 45%",
    alt: "Healed microblading, fine individual hair strokes",
  },
  {
    ref: "eyeliner/03",
    col: 3,
    row: 5,
    span: 3,
    focus: "50% 45%",
    alt: "Healed permanent eyeliner, close up",
  },
] as const;

const heroTiles = heroTileSpecs.flatMap((t) => {
  const photo = localPhoto(t.ref, t.alt);
  return photo ? [{ photo, col: t.col, row: t.row, span: t.span, focus: t.focus }] : [];
});
// One image per slot on this page. Not ombre-powder-brows/04 (an Instagram pick) and not
// microblading-shading/02, which is byte-identical to ombre-powder-brows/02 in the hero --
// the client supplied the same photograph under both service names.
const aboutPhoto = localPhoto("microblading-shading/06", "Healed microblading and shading on a client in her forties, by Pomi");

const title = `${settings.businessName} | Natural permanent makeup in Tustin, near Irvine`;
---

<Base
  title={title}
  description={settings.metaDescription}
  settings={settings}
  services={services}
  faqs={faqs}
  canonicalPath="/"
  ogImage="/og.jpg"
>
  {/* Reassure first: the result, the method, the work, then the proof, then who and what it costs. */}
  {heroTiles.length > 0 && <Hero settings={settings} tiles={heroTiles} />}
  <HealingAxis />
  <InstagramGrid settings={settings} services={services} />
  <Reviews reviews={reviews} settings={settings} />
  <AboutPomi settings={settings} services={services} fallbackPhoto={aboutPhoto} />
  <PricingTable services={services} />
  <Faq faqs={faqs} />
  <ContactForm settings={settings} services={services} />
</Base>
